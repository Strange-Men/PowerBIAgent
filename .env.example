# ============================================================
# PowerBIAgent 环境配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中排除，不会被提交
# Claude 和其他自动化工具不得读取 .env 内容
# ============================================================

# ----------------------------------------------------------
# 运行模式
# ----------------------------------------------------------
app_env=development
llm_mode=mock
powerbi_mode=mock
harness_mode=strict

# ----------------------------------------------------------
# 服务器
# ----------------------------------------------------------
host=127.0.0.1
port=8000
debug=true
log_level=info

# ----------------------------------------------------------
# DeepSeek LLM（用户本人本地填写）
# ----------------------------------------------------------
deepseek_api_key=
deepseek_base_url=https://api.deepseek.com/v1
deepseek_model=deepseek-chat

# ----------------------------------------------------------
# Power BI MCP（用户本人本地填写）
# ----------------------------------------------------------
powerbi_tenant_id=
powerbi_client_id=
powerbi_client_secret=
powerbi_mcp_endpoint=
# M2.1 Local MCP Demo：官方 npm 包固定 Preview 版本并强制只读
powerbi_local_mcp_executable=npx
powerbi_local_mcp_package=@microsoft/powerbi-modeling-mcp@0.5.0-beta.12
powerbi_local_mcp_readonly=true

# ----------------------------------------------------------
# 资源限制
# ----------------------------------------------------------
request_timeout_seconds=120
powerbi_query_timeout_seconds=30
max_tool_calls=4
max_dax_repairs=1
max_llm_format_retries=1
max_powerbi_retries=1
max_query_rows=1000
max_user_input_length=2000
