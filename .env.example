# ============================================================
# PowerBIAgent 环境配置模板
# 复制此文件为 .env 并填入真实值
# 每个非注释行必须保持单行 KEY=value；不要粘贴 Markdown、命令或说明文字
# .env 文件已在 .gitignore 中排除，不会被提交
# Claude 和其他自动化工具不得读取 .env 内容
# ============================================================

# ----------------------------------------------------------
# 运行模式
# ----------------------------------------------------------
app_env=development
llm_mode=mock
llm_default_profile=deepseek
powerbi_mode=mock
harness_mode=strict

# ----------------------------------------------------------
# 服务器
# ----------------------------------------------------------
host=127.0.0.1
port=8000
debug=true
log_level=info

# ----------------------------------------------------------
# DeepSeek LLM（用户本人本地填写）
# ----------------------------------------------------------
deepseek_api_key=
deepseek_base_url=https://api.deepseek.com/v1
deepseek_model=deepseek-chat

# ----------------------------------------------------------
# Kimi K2.6（用户自有 OpenAI-compatible gateway；必须显式填写 host/key）
# ----------------------------------------------------------
kimi_api_key=
kimi_base_url=
kimi_model=azure/Kimi-K2.6

# 可选成本元数据；留空时 estimated_cost_usd=null，禁止猜价
# deepseek_input_cost_per_million_tokens=自行核实后填写
# deepseek_output_cost_per_million_tokens=自行核实后填写
# kimi_input_cost_per_million_tokens=自行核实后填写
# kimi_output_cost_per_million_tokens=自行核实后填写

# ----------------------------------------------------------
# Power BI MCP（用户本人本地填写）
# ----------------------------------------------------------
powerbi_tenant_id=
powerbi_client_id=
powerbi_client_secret=
powerbi_mcp_endpoint=
# M2.1 Local MCP Demo：官方 npm 包固定 Preview 版本并强制只读
powerbi_local_mcp_executable=npx
powerbi_local_mcp_package=@microsoft/powerbi-modeling-mcp@0.5.0-beta.12
powerbi_local_mcp_readonly=true

# ----------------------------------------------------------
# 会话持久化
# ----------------------------------------------------------
# memory 仅适合无历史的兼容/离线启动；React recent/search/history 使用 sqlite
persistence_backend=memory
persistence_database_path=local_state/persistence/powerbiagent.db

# ----------------------------------------------------------
# 资源限制
# ----------------------------------------------------------
request_timeout_seconds=120
powerbi_query_timeout_seconds=30
max_tool_calls=8
max_dax_repairs=1
max_llm_format_retries=1
max_powerbi_retries=1
max_query_rows=1000
max_user_input_length=2000
