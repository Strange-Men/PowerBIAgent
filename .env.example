# ============================================================
# PowerBIAgent 
# Local Cloud Normal Product Environment
# Entra BFF + Fabric IQ + DeepSeek/Kimi + SQLite
# ============================================================


# ============================================================
# Application
# ============================================================

app_env=development
debug=true

host=127.0.0.1
port=8000
log_level=info
application_timezone=Asia/Shanghai

harness_mode=strict


# ============================================================
# Microsoft Entra / BFF Authentication
# ============================================================

identity_mode=ENTRA_BFF

entra_tenant_id=<<<回填你的 ENTRA_TENANT_ID>>>
entra_client_id=<<<回填你的 ENTRA_CLIENT_ID>>>
entra_client_secret=<<<回填你的 ENTRA_CLIENT_SECRET>>>

entra_redirect_uri=http://localhost:5173/auth/callback
auth_allowed_origin=http://localhost:5173

# 本地 development 使用 HTTP，因此必须 false。
# VM/正式 HTTPS 部署时再改 true。
auth_cookie_secure=false

auth_cookie_name=pbiagent_session
auth_session_ttl=3600
auth_flow_ttl=300
auth_store_capacity=1024


# ============================================================
# Runtime
# ============================================================

# 当前必须使用 Fabric IQ Cloud MCP。
# 不要再写 local_mcp。
powerbi_mode=fabric_iq

llm_mode=deepseek
llm_default_profile=deepseek


# ============================================================
# Cloud Normal Product Policy
# ============================================================

# false = 正常产品模式
# true = M6 Cloud Test Allowlist 模式
fabric_test_mode=false

# 允许经过服务器授权后的业务数据发送给配置的外部 LLM。
allow_external_llm_disclosure=true

# 允许 History / Memory / Report 等业务持久化。
allow_business_persistence=true


# ============================================================
# Fabric IQ Cloud MCP
# ============================================================

fabric_iq_endpoint=https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq
fabric_iq_variant=Fabric.Routing.FabricIQ.V1
fabric_iq_timeout_seconds=60


# ============================================================
# DeepSeek Profile
# ============================================================

deepseek_api_key=<<<回填你的 DEEPSEEK_API_KEY>>>

deepseek_base_url=https://aimiddleplatform.edensoft.ai
deepseek_model=azure/DeepSeek-V4-Flash

# 不确定价格时保持注释，系统返回 cost=null。
# deepseek_input_cost_per_million_tokens=
# deepseek_output_cost_per_million_tokens=


# ============================================================
# Kimi Profile
# ============================================================

kimi_api_key=<<<回填你的 KIMI_API_KEY>>>

kimi_base_url=https://aimiddleplatform.edensoft.ai
kimi_model=azure/Kimi-K2.6

# kimi_input_cost_per_million_tokens=
# kimi_output_cost_per_million_tokens=


# ============================================================
# Legacy / Local Power BI MCP
#
# 当前 powerbi_mode=fabric_iq，因此这些不会参与本次 Cloud 测试。
# 保留只是为了以后切回 Local MCP 时不用重新找配置。
# ============================================================

powerbi_local_mcp_executable=npx
powerbi_local_mcp_package=@microsoft/powerbi-modeling-mcp@0.5.0-beta.12
powerbi_local_semantic_model_key=local_desktop_model
powerbi_local_mcp_readonly=true


# ============================================================
# Legacy Remote Power BI Configuration
#
# Fabric IQ + Entra BFF 当前不依赖这里的 client secret。
# 没有明确用途就保持空。
# ============================================================

powerbi_tenant_id=
powerbi_client_id=
powerbi_client_secret=
powerbi_mcp_endpoint=


# ============================================================
# Persistence
# ============================================================

persistence_backend=sqlite
persistence_database_path=local_state/persistence/powerbiagent.db

report_artifacts_path=local_state/reports
presentation_localization_registry_path=local_state/runtime/display_localizations.json


# ============================================================
# Request / Provider Timeouts
# ============================================================

request_timeout_seconds=180

llm_provider_timeout_seconds=120

fabric_iq_timeout_seconds=60

powerbi_query_timeout_seconds=30
powerbi_local_mcp_timeout_seconds=120

report_render_timeout_seconds=120


# ============================================================
# LLM Retry
# ============================================================

llm_max_attempts=3
llm_retry_base_seconds=0.25
llm_retry_max_seconds=2.0
llm_retry_jitter_ratio=0.2


# ============================================================
# Runtime Limits
# ============================================================

max_tool_calls=8

max_dax_repairs=1
max_llm_format_retries=1

max_powerbi_retries=1

max_query_rows=1000
max_user_input_length=2000


# ============================================================
# Local MCP Concurrency
#
# 当前 Fabric IQ 模式不会作为主要 Cloud runtime 使用，
# 保留仓库默认配置。
# ============================================================

powerbi_local_mcp_workers=2
powerbi_local_mcp_queue_capacity=32
powerbi_local_mcp_per_request_limit=2
powerbi_local_mcp_admission_timeout_seconds=0.5

report_query_concurrency=2